# MANIFEST.in — 让 sdist（python -m build）也包含规则源文件
# setup.py 的 sdist 子类会先把源同步到 agentseed/_resources/，
# 这里额外保险：把仓库根的源目录也直接 include 到 sdist（便于在 sdist 目录里直接 pip install）。

include README.md README.zh.md README.ja.md
include LICENSE
include pyproject.toml setup.py
include mcp.example.json

graft core
graft personas
graft capabilities
graft adapters

# 打包时由 setup.py 同步出来的 _resources/ 也包含进 sdist（双保险）
graft agentseed/_resources

# 排除生成产物（.gitignore 已忽略的，sdist 也不应带）
prune .git
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
