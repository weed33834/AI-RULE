{
  "name": "dar",
  "version": "1.0.0",
  "description": "Domain-Aware Retrieval: 按查询域名路由到 T1-T4 权威源，四维度评分",
  "tools": [
    {
      "name": "route_source",
      "description": "接收查询关键词，按 DAR 路由表返回匹配的权威源优先级列表（T1 官方优先，T4 强制审查）",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "检索关键词" },
          "domain": { "type": "string", "description": "目标域（如 coding/novel/paper）" }
        },
        "required": ["query"]
      }
    },
    {
      "name": "score_credibility",
      "description": "对给定源按 R/C/F/S 四维打分，返回评分报告",
      "parameters": {
        "type": "object",
        "properties": {
          "source_url": { "type": "string", "description": "待评分源的 URL 或标识符" },
          "domain": { "type": "string", "description": "目标域" }
        },
        "required": ["source_url"]
      }
    }
  ],
  "resources": ["source_registry", "routing_rules", "scoring_protocol", "domain_mapping"]
}
