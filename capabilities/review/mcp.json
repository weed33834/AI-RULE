{
  "name": "review",
  "version": "1.0.0",
  "description": "Review capability: 代码审查、架构审查、AI 错误检测",
  "tools": [
    {
      "name": "review_code",
      "description": "按五子角色 Critics 标准审查代码，逐行标注 BLOCKER/WARNING",
      "parameters": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "目标文件或目录绝对路径" },
          "level": { "type": "string", "enum": ["quick", "full", "strict"], "default": "full", "description": "审查深度" }
        },
        "required": ["path"]
      }
    }
  ],
  "resources": ["review_standards", "blocker_checklist", "ai_error_detection"]
}
